#pragma code_page(65001)
#include <winver.h>

// 入力の方法の一覧に出すアイコン (RegisterProfile のアイコンの番号 0)
101 ICON "shunti.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "shuntilettuce"
            VALUE "FileDescription", "shunti IME (日本語入力)"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "shunti_ime"
            VALUE "LegalCopyright", "MIT License"
            VALUE "ProductName", "shunti IME"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
