export class EmojiSuggest {
  // Emoji for a just-committed surface, most-apt first, or [] if the word has
  // no conventional emoji association.
  //
  // AI 変換は文ごと確定する (今日は疲れた) ので、文の末尾のいちばん長い一致で引く。言い方の揺れ (疲れました・疲れちゃった・
  // 嬉しいです) は、表の形 (疲れた・嬉しい) に戻してから引く (ユーザー 2026-10-13)
  static forSurface(surface: string): string[] {
    const t = surface.replace(/[。．、！!？?ー〜~…・wｗ笑]+$/, '');
    for (let i = 0; i < t.length; i++) {
      for (const k of EmojiSuggest.forms(t.slice(i))) {
        const e = EMOJI_FOR_SURFACE[k];
        if (e !== undefined) { return e; }
      }
    }
    return [];
  }

  // 表で引く形: そのまま、丁寧・くだけた言い方を た / 言い切りに戻した形
  private static forms(s: string): string[] {
    const out: string[] = [s];
    for (const p of PAST_FORMS) {
      if (s.length > p.length && s.endsWith(p)) { out.push(s.slice(0, s.length - p.length) + 'た'); }
    }
    for (const p of TAIL_PARTICLES) {
      if (s.length > p.length && s.endsWith(p)) { out.push(s.slice(0, s.length - p.length)); }
    }
    return out;
  }
}

// 疲れました・疲れちゃった・疲れてる -> 疲れた
const PAST_FORMS: string[] = ['てしまいました', 'ちゃいました', 'てしまった', 'ちゃった', 'ちゃう', 'ました', 'ています', 'ている', 'てる', 'ます'];
// 嬉しいです・最高だね -> 嬉しい・最高 (長いものから)
const TAIL_PARTICLES: string[] = ['ですね', 'ですよ', 'でした', 'です', 'だね', 'だよ', 'だな', 'すぎる', 'すぎ', 'ね', 'よ', 'な', 'わ', 'だ'];
