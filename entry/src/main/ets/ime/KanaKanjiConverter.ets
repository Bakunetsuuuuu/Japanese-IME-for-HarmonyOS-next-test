export class KanaKanjiConverter {
  private static supplementaryDict: Record<string, string[]> = {};
  private static learned: Record<string, Record<string, number>> = {};
  private static userDict: Record<string, string[]> = {};
  // Developer-curated dictionary bundled as rawfile/global_dict.json. Highest priority.
  private static globalDict: Record<string, string[]> = {};
  // Viterbi cost data loaded from rawfile/reading_cost.json (generated by tools/build_viterbi_dict.py).
  // Maps reading → [nodeCost, leftMacroClass, rightMacroClass]. Empty until loaded; falls back to heuristics.
  private static costDict: Record<string, number[]> = {};
  // 15×15 macro-class connection cost matrix from rawfile/matrix.json.
  private static connectionMatrix: number[][] = [];
  // Ring buffer of up to 15 recently confirmed output strings for context re-ranking.
  private static contextBuffer: string[] = [];

  // Particles and auxiliaries kept as kana in auto-convert and preferred during DP traceback
