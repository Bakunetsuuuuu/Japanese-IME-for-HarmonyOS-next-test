// A maximal kana-numeral run found in an input (start position implied by
// the map key it's stored under).
interface MozcNumeralRun {
  len: number;
  surface: string;
}

export interface MozcMatrixData {
  size: number;
  bosClass: number;
  unknownClass: number;
  contentClassMask: number[]; // 1 = open-class content POS (名詞/形容詞/副詞/連体詞/接頭詞 -- 動詞 deliberately excluded, see build_mozc_engine.py's CONTENT_POS_MAJOR comment), 0 = function-word-ish
  // Raw id of 名詞,一般 -- the class user-dictionary spans are scored as
  // (a user-registered word is a generic noun as far as the DP is
  // concerned). Optional: older generated files predate it.
  nounGeneralClass?: number;
  // Raw id of generic 名詞,数,漢数字 -- the class the numeral pre-pass
  // scores composed kanji-number spans as. Optional, same reason.
  kanjiNumberClass?: number;
  // The N*N connection matrix itself is no longer part of this JSON header --
  // it ships as a flat uint16 binary (mozc_matrix.bin) passed to loadMozcEngine
  // separately. See build_mozc_engine.py's write_outputs.
}

// One grammatical sense a reading can take (see tools/mozc_data/
// build_mozc_engine.py's "Node cost / class per reading" doc). A reading
// with genuine grammatical ambiguity (e.g. し: する's stem vs. a classical
// auxiliary form) carries several of these; segment()'s Viterbi DP tries
// each and lets normal cost minimization pick whichever fits context.
interface MozcSense {
  cost: number;
  leftClass: number;
  rightClass: number;
  surface: string;
}

// One reachable (position, class) state in segment()'s track-B Viterbi DP
// (see segment()'s own comment for why this replaced a single-state-per-
// position array): the cheapest way found so far to reach this position
// while ending in this specific class, plus enough to backtrace through.
interface MozcDpState {
  cost: number;
  prevPos: number;
  prevClass: number;
  surface: string | undefined;
}

