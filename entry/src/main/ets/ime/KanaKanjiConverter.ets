  static loadDictionary(dict: Record<string, string[]>): void {
    KanaKanjiConverter.supplementaryDict = dict;
  }

  static setUserDict(dict: Record<string, string[]>): void {
    KanaKanjiConverter.userDict = dict;
  }

  static setUserClassMap(classMap: Record<string, number[]>): void {
    KanaKanjiConverter.userClassMap = classMap;
  }

  static setGlobalDict(dict: Record<string, string[]>): void {
    KanaKanjiConverter.globalDict = dict;
  }

  // Build and store the connection matrix from inline grammar rules (no JSON file needed).
  static initConnectionMatrix(): void {
    KanaKanjiConverter.connectionMatrix = KanaKanjiConverter.buildConnectionMatrix();
  }

  // Track B (see field comments above). Loads the mozc-derived rawfiles,
  // pre-flattened at build time by tools/mozc_data/convert_to_binary.py --
  // no JSON.parse of any per-reading structure happens on-device anymore
  // (that parse tree, plus the columnar flattening this function used to do
  // from it, is what drove the OOM: both existed in memory at once). Does
  // not touch any track-A state. Call once, lazily, the first time the user
  // switches the conversionEngine setting to 'mozc' — see
  // KeyboardController.reloadSettings().
  static loadMozcEngine(readings: string[], dictSurfaces: string[], dictIndex: Uint32Array,
      costsSurfaces: string[], costsIndex: Uint32Array, costsCost: Int32Array,
      costsLeft: Uint16Array, costsRight: Uint16Array,
      matrixData: MozcMatrixData, matrixCells: Uint16Array): void {
    const readingIndex = new Map<string, number>();
    for (let i = 0; i < readings.length; i++) { readingIndex.set(readings[i], i); }
    KanaKanjiConverter.mozcReadingIndex = readingIndex;
    KanaKanjiConverter.mozcDictSurfaces = dictSurfaces;
    KanaKanjiConverter.mozcDictIndex = dictIndex;
    KanaKanjiConverter.mozcCostIndex = costsIndex;
    KanaKanjiConverter.mozcCostCostArr = costsCost;
    KanaKanjiConverter.mozcCostLeftArr = costsLeft;
    KanaKanjiConverter.mozcCostRightArr = costsRight;
    KanaKanjiConverter.mozcCostSurfaceArr = costsSurfaces;
    // Flat row-major connection matrix straight from mozc_matrix.bin -- no
    // reshape into a boxed number[][] (that array was the mozc engine's biggest
    // heap cost and the OOM crash's dominant driver).
    KanaKanjiConverter.mozcMatrix = matrixCells;
    KanaKanjiConverter.mozcMatrixSize = matrixData.size;
    KanaKanjiConverter.mozcBosClass = matrixData.bosClass;
    KanaKanjiConverter.mozcUnknownClass = matrixData.unknownClass;
    KanaKanjiConverter.mozcNounGeneralClass = matrixData.nounGeneralClass ?? -1;
    KanaKanjiConverter.mozcKanjiNumberClass = matrixData.kanjiNumberClass ?? -1;
    KanaKanjiConverter.mozcContentClassMask = matrixData.contentClassMask;
  }

  // mozc_dict_surfaces.json / mozc_dict_index.bin equivalent of
  // mozcDict[reading] under the old Record<string,string[]> shape --
  // reconstructs a plain string[] slice on demand (transient, GC'd).
  private static getMozcDictSurfaces(reading: string): string[] | undefined {
    const idx = KanaKanjiConverter.mozcReadingIndex.get(reading);
    if (idx === undefined) { return undefined; }
    const start = KanaKanjiConverter.mozcDictIndex[idx];
    const end = KanaKanjiConverter.mozcDictIndex[idx + 1];
    return KanaKanjiConverter.mozcDictSurfaces.slice(start, end);
  }

  static isMozcLoaded(): boolean {
    return KanaKanjiConverter.mozcMatrixSize > 0;
  }

  // 'mozc'/'hybrid' are only actually honored if loadMozcEngine() has already
  // been called — falls back to 'custom' otherwise so a not-yet-loaded engine
  // can never silently produce empty/broken conversions.
  static setEngine(e: 'custom' | 'mozc' | 'hybrid'): void {
    KanaKanjiConverter.engine = ((e === 'mozc' || e === 'hybrid') && KanaKanjiConverter.isMozcLoaded()) ? e : 'custom';
  }

  static getEngine(): 'custom' | 'mozc' | 'hybrid' {
    return KanaKanjiConverter.engine;
  }

  static setLearned(data: Record<string, Record<string, number>>): void {
    KanaKanjiConverter.learned = data;
  }

  static getLearned(): Record<string, Record<string, number>> {
    return KanaKanjiConverter.learned;
  }

  static recordChoice(kana: string, candidate: string): void {
    if (kana.length === 0 || candidate.length === 0 || candidate === kana) { return; }
    if (!KanaKanjiConverter.learned[kana]) {
      if (Object.keys(KanaKanjiConverter.learned).length >= 500) { return; }
      KanaKanjiConverter.learned[kana] = {};
    }
    const entry = KanaKanjiConverter.learned[kana];
    if (entry[candidate] !== undefined || Object.keys(entry).length < 5) {
      entry[candidate] = (entry[candidate] ?? 0) + 1;
    }
  }

  // Per-segment ("文節") learning for the ordinary whole-sentence commit path.
  // Committing a multi-segment candidate used to record only the entire
  // reading→surface pair (recordChoice(wholeReading, wholeSurface)), a key
  // that essentially never recurs verbatim -- so correcting しゃしんをとった
  // to 写真を撮った taught the IME nothing about とった→撮った for the next
  // sentence. Recording each (segmentReading, segmentSurface) the accepted
  // candidate is actually built from makes homophone corrections generalize
  // word-by-word the way every mature IME's learning does. Only the common
  // commit path lacked this; the 文節 editing flow (commitBunsetsu) already
  // recorded per segment. `readings` and `surfaces` are parallel arrays (one
  // entry per segment); recordChoice's own kana===surface guard drops the
  // particles/auxiliaries that stayed hiragana, so only content words learn.
  static recordSegmentedChoice(readings: string[], surfaces: string[]): void {
    const n = Math.min(readings.length, surfaces.length);
    for (let i = 0; i < n; i++) {
      KanaKanjiConverter.recordChoice(readings[i], surfaces[i]);
    }
  }

  private static applyLearning(kana: string, cands: string[]): string[] {
    const counts = KanaKanjiConverter.learned[kana];
    if (!counts || Object.keys(counts).length === 0) { return cands; }
    const boosted = cands.filter((c: string) => (counts[c] ?? 0) > 0)
      .sort((a: string, b: string) => (counts[b] ?? 0) - (counts[a] ?? 0));
    const rest = cands.filter((c: string) => (counts[c] ?? 0) === 0);
    return [...boosted, ...rest];
  }

  // Prepend user-registered words (deduped), keeping them ahead of dict order.
  // Prepend the words of a registered dictionary (deduped), keeping them ahead.
  private static withRegisteredWords(
    registered: string[] | undefined,
    list: string[]
  ): string[] {
    if (!registered || registered.length === 0) { return list; }
    const rest = list.filter((c: string) => !registered.includes(c));
    return [...registered, ...rest];
  }

  // Folds a registered dictionary's words in as *additional* candidates without
  // letting them jump ahead of already-ordered results. global_dict.json is a
  // bulk-synced ~150k-entry corpus, not hand-ranked per reading, and blindly
  // prepending it (the old withRegisteredWords behavior) let obscure entries
  // (e.g. 太作 for たいさく, 屍体 for したい, 丹後 for たんご) bury common,
  // correctly-ordered candidates already produced by DICTIONARY/dict.json.
  private static appendRegisteredWords(
    registered: string[] | undefined,
    list: string[]
  ): string[] {
    if (!registered || registered.length === 0) { return list; }
    const extra = registered.filter((c: string) => !list.includes(c));
    return [...list, ...extra];
  }

  // Known-common words/readings that should outrank obscure homographs
  // regardless of which dictionary source contributed them (see
  // appendRegisteredWords above for why global_dict order can't be trusted).
  // Not exhaustive — extend as more mis-rankings are reported.
  private static readonly COMMON_WORDS: Set<string> = new Set([
    // Bracket/punctuation symbols (かっこ family)
    '()', '（）', '「」', '『』', '【】', '｛｝', '{}', '[]', '〔〕', '［］',
    // Reported mis-rankings
    '対策', '単語', '返事', '期待',
    // Common "want to ~" verb forms often buried by obscure homographs
    '会いたい', '買いたい', '書きたい', '行きたい', '来たい',
    // News/forum-register nouns whose dict.json entry lists kana or a rarer
    // kanji homograph ahead of the common kanji form (住民 behind kana,
    // 回復 behind rare-kanji 恢復, etc.) — see appendRegisteredWords/
    // dict-ordering note above for why source order can't be trusted.
    '住民', '上昇', '成立', '回復', '一緒', '遅延', '今回', '会おう',
    '進出', '深刻', '接近', '延期', '飲み', '酷い', 'お出かけ', '話',
    '動向', '実家', '添付', '施行', '山田', '五百円玉',
  ]);

  private static boostCommonWords(cands: string[]): string[] {
    const common: string[] = [];
    const rest: string[] = [];
    for (const c of cands) {
      if (KanaKanjiConverter.COMMON_WORDS.has(c)) { common.push(c); } else { rest.push(c); }
    }
    return common.length > 0 ? [...common, ...rest] : cands;
  }

  static addContext(text: string): void {
    if (text.length === 0) { return; }
    KanaKanjiConverter.contextBuffer.push(text);
    if (KanaKanjiConverter.contextBuffer.length > 15) {
      KanaKanjiConverter.contextBuffer = KanaKanjiConverter.contextBuffer.slice(1);
    }
  }

  // Called from InputHandler.insertText() with the text that was just committed,
  // so subsequent lookups know whether they immediately follow a confirmed Arabic digit.
  static setLastCommitText(text: string): void {
    if (text.length === 0) { return; }
    KanaKanjiConverter.lastCommitWasDigit = /[0-9０-９]$/.test(text);
    KanaKanjiConverter.lastCommitHadKanji = /[一-鿿]/.test(text);
  }

  // Applies both post-lookup context boosts (助数詞 after digits, 地名接尾語 after kanji words).
  // Named boostCounterWords for historical reasons; all call sites route through here.
  private static boostCounterWords(cands: string[]): string[] {
    return KanaKanjiConverter.boostPlaceSuffixWords(
      KanaKanjiConverter.applyCounterBoost(cands));
  }

  private static applyCounterBoost(cands: string[]): string[] {
    if (!KanaKanjiConverter.lastCommitWasDigit || cands.length < 2) { return cands; }
    const boosted = cands.filter((c: string) => KanaKanjiConverter.COUNTER_WORDS.has(c));
    if (boosted.length === 0) { return cands; }
    const rest = cands.filter((c: string) => !KanaKanjiConverter.COUNTER_WORDS.has(c));
    return [...boosted, ...rest];
  }

  // 直前に地名らしい語（漢字を含む語）が確定していた場合、駅・空港等の地名接尾語候補を前方に寄せる。
  private static boostPlaceSuffixWords(cands: string[]): string[] {
    if (!KanaKanjiConverter.lastCommitHadKanji || cands.length < 2) { return cands; }
    const boosted = cands.filter((c: string) => KanaKanjiConverter.PLACE_SUFFIX_WORDS.has(c));
    if (boosted.length === 0) { return cands; }
    const rest = cands.filter((c: string) => !KanaKanjiConverter.PLACE_SUFFIX_WORDS.has(c));
    return [...boosted, ...rest];
  }

  // 直前コンテキストが格助詞の場合、漢字を含む候補（名詞・動詞）を前方に寄せる。
  // 例:「は」確定後「かいて」→「書いて」「描いて」が「買い手」より前に来る。
  private static postParticleBoost(cands: string[]): string[] {
    const buf = KanaKanjiConverter.contextBuffer;
    if (buf.length === 0 || cands.length < 2) { return cands; }
    const last = buf[buf.length - 1];
    if (!KanaKanjiConverter.CASE_PARTICLES.has(last)) { return cands; }
    const withKanji = cands.filter((c: string) => /[一-鿿]/.test(c));
    if (withKanji.length < 2) { return cands; }
    const rest = cands.filter((c: string) => !/[一-鿿]/.test(c));
    return [...withKanji, ...rest];
  }

  // 辞書未登録の連続読みに対してViterbi分割→各セグメント変換→結合を試みる。
  // lookup() 内から fromNorm=false の場合のみ呼ぶ（無限ループ回避）。
  //
  // 漢字を含む結合結果は常に信頼できる（例: たべ+てた→食べてた）。
  // 漢字が無い場合でも、全セグメントが実際の辞書エントリまたは機能語（助詞・助動詞）で
  // 説明できるなら、それは「してね」＝して(する)+ね(終助詞) のような正当な口語表現であり、
  // 単なる未知語のカタカナ化より優先されるべき。1文字でも正体不明（辞書にもFUNCTION_WORDSにも
  // 無く、生の読みをそのままechoしただけ）のセグメントが混じる場合は信頼しない。
  private segmentJoinFallback(kana: string): string | null {
    const segs = this.segment(kana);
    if (segs.length < 2) { return null; }
    return this.joinSegs(segs);
  }

  // Per-segment join used by both segmentJoinFallback (unregistered readings)
  // and findAlternateSegmentation (offering a second, differently-segmented
  // candidate for readings that already resolve via a single whole-phrase
  // dictionary entry). Pulled out so every join goes through the same
  // grammar special-cases (てきた/てきて, あい/すいの様態, COLLOCATION_HINTS)
  // instead of two copies drifting apart.
  private joinSegs(segs: string[]): string | null {
    let joined = '';
    let allRecognized = true;
    for (let idx = 0; idx < segs.length; idx++) {
      const seg = segs[idx];
      const g = KanaKanjiConverter.globalDict[seg];
      const e = DICTIONARY[seg];
      const s = KanaKanjiConverter.supplementaryDict[seg];
      const fw = KanaKanjiConverter.FUNCTION_WORDS[seg];
      const hasDictHit = !!((g && g.length > 0) || (e && e.length > 0) || (s && s.length > 0));
      if (!hasDictHit && !fw) { allRecognized = false; }
      // Route through the full lookup() pipeline rather than re-deriving a
      // priority order here from raw g/e/s access. That hand-rolled version
      // (global > DICTIONARY > dict.json) drifted out of sync with every
      // dict-ranking fix made to lookup() itself (global demotion,
      // COMMON_WORDS boost, markup-artifact filtering) — e.g. it kept
      // picking 括弧 over the symbol candidates for かっこ here even after
      // lookup('かっこ') was fixed directly, because this loop never called
      // lookup() at all.
      let best = KanaKanjiConverter.COLLOQUIAL_KANA[seg] ?? (fw ? seg : hasDictHit ? this.lookup(seg, true)[0] : seg);
      // てきた/てきて aspectual aux ("空が曇ってきた"): きた/きて directly after a
      // segment ending in て/で is the auxiliary, not 来た/来て — the te-form
      // already attaches the verb, so a homograph lookup would be double
      // counting a second verb. Bare き gets the same treatment when it's
      // the further-contracted casual form (忘れてきちゃった -> わすれて+き+
      // ちゃった, where き alone is 来[た/て] before ちゃう swallows the
      // rest) -- lookup('き') alone would pick 気/木/黄 over this 来る stem.
      if (idx > 0 && segs[idx - 1].length > 1 && /[てで]$/.test(segs[idx - 1]) &&
          ((seg === 'きた' || seg === 'きて') ||
           (seg === 'き' && idx + 1 < segs.length && segs[idx + 1].startsWith('ちゃ')))) {
        best = seg;
      }
      // いった directly after a て/で-ending segment ("着ていった") is the
      // literal verb 行った (went) coordinated with the preceding action, not
      // 言った (said) -- 言う attaches after a quotation/topic (と言った),
      // essentially never directly onto a bare te-form.
      if (seg === 'いった' && idx > 0 && segs[idx - 1].length > 1 &&
          /[てで]$/.test(segs[idx - 1])) {
        best = '行った';
      }
      // なくなった directly after a segment ending in れ (a potential-verb
      // stem: 眠れ/食べられ/見れ/来れ, ...) is the auxiliary negation
      // ("〜れなくなった" = became unable to ~"), conventionally kana, not
      // the standalone verb 無くなった ("ran out/disappeared") that
      // lookup('なくなった') ranks first alone.
      if (seg === 'なくなった' && idx > 0 && segs[idx - 1].endsWith('れ')) {
        best = seg;
      }
      // やすい directly after another segment (not sentence-initial) is
      // almost always the "-yasui" (easy to ~) auxiliary attaching to a verb
      // stem (くずしやすい, こわれやすい), not the standalone adjective 安い/
      // 易しい that lookup('やすい') ranks first alone -- 安い as a genuine
      // independent adjective needs its own subject marking (は/が) or comes
      // sentence-initially, so a やすい directly glued onto a non-particle
      // segment with no particle between them essentially never means
      // "cheap" in real text.
      if (seg === 'やすい' && idx > 0 &&
          !KanaKanjiConverter.CASE_PARTICLES.has(segs[idx - 1]) &&
          !KanaKanjiConverter.FW_CLASS_MAP[segs[idx - 1]]) {
        best = seg;
      }
      // あい/すい directly before てる/てい(る)/てた/た is the い-form of
      // 開く/空く ("store's あいてる" = open, "train's すいてる" =
      // uncrowded), not whichever homograph (合い/会い/愛, 水/吹/推/...)
      // lookup() would otherwise pick for the bare 2-mora reading on its
      // own. あいて/すいて (already merged with て by the segmenter, since
      // あいて/相手 is itself a recognized word) get the same treatment
      // when followed by past-tense た.
      if (idx + 1 < segs.length) {
        const next = segs[idx + 1];
        if (next === 'た' && (seg === 'あいて' || seg === 'すいて')) {
          best = seg === 'あいて' ? '開いて' : '空いて';
        } else if (/^(てる|てい|てた|た|ます|ませ)/.test(next)) {
          if (seg === 'あい') { best = '開い'; }
          else if (seg === 'すい') { best = '空い'; }
          // はなし directly before a continuation aux is the renyou stem of
          // 話す ("よく話してる" = talks a lot), not the bare noun 話 (story/
          // topic) that lookup('はなし') ranks first on its own.
          else if (seg === 'はなし') { best = '話し'; }
        }
        // なん directly before ちゃう is the casual/Kansai-dialect filler of
        // なんちゃう(か) ("だけなんちゃうか" = "isn't it just that..."), not
        // the interrogative 何 that lookup('なん') ranks first on its own --
        // 何 essentially never precedes the てしまう-contraction ちゃう in
        // legitimate formal usage, so this is safe to key on the bigram alone.
        if (seg === 'なん' && next.startsWith('ちゃう')) { best = 'なん'; }
        // は directly before を can't be the topic particle は (grammatically,
        // は never precedes another particle -- there'd have to be a noun in
        // between) -- it's the noun 歯 (tooth) instead. Overrides the
        // FUNCTION_WORDS['は']=true short-circuit above, which otherwise
        // always keeps a bare は in kana regardless of context.
        if (seg === 'は' && next === 'を') { best = '歯'; }
        // かぜ directly before を+ひく-family (風邪をひいた/ひく/ひきそう/
        // ひかない/ひこう) is always the illness 風邪, never the literal 風
        // (wind) that lookup('かぜ') ranks first alone -- 風をひく isn't
        // idiomatic Japanese. The ひく-family verb itself is separately kept
        // in kana by the かぜ|ひい.../COLLOCATION_HINTS entries below, since
        // this idiom conventionally writes it that way even once かぜ itself
        // is kanji.
        if (seg === 'かぜ' && next === 'を' && idx + 2 < segs.length && /^ひ[いくきかこ]/.test(segs[idx + 2])) {
          best = '風邪';
        }
      }
      // Noun+particle→verb collocation (COLLOCATION_HINTS): 「〜を<noun>を
      // <verb>」within the same phrase picks the verb kanji that noun
      // actually collocates with (かさをかいた→買った, not 書いた/飼った),
      // rather than whichever homograph lookup() would pick for the bare
      // verb reading. Also covers に (destination: びょういんにいって→
      // 行って, not 言って) and が (subject: どけいがなって→鳴って, not
      // なって/成って) — same disambiguation, different particle.
      if (idx >= 2 && (segs[idx - 1] === 'を' || segs[idx - 1] === 'に' || segs[idx - 1] === 'が')) {
        const obj = segs[idx - 2];
        for (const hintKey of Object.keys(COLLOCATION_HINTS)) {
          const sep = hintKey.indexOf('|');
          const hintNoun = hintKey.slice(0, sep);
          const hintVerb = hintKey.slice(sep + 1);
          if (hintNoun === obj && seg.startsWith(hintVerb)) {
            best = COLLOCATION_HINTS[hintKey] + seg.slice(hintVerb.length);
            break;
          }
        }
      }
      // Adjacent-pair hint (ADJACENT_PAIR_HINTS): two segments sitting right
      // next to each other reading as a different compound together than
      // either would alone (へんかん+せいど -> 返還制度, not 変換+制度).
      if (idx + 1 < segs.length) {
        const pairHint = ADJACENT_PAIR_HINTS[seg + '|' + segs[idx + 1]];
        if (pairHint !== undefined) { best = pairHint; }
      }
      // A segment that resolves to a bare symbol (e.g. かっこ→"()") means the
      // segmenter split a casual string across a symbol "word"; the joined
      // phrase would be nonsense like "()よ". Abandon the join so the plain
      // hiragana leads instead.
      if (KanaKanjiConverter.isSymbolOnly(best)) { return null; }
      joined += best;
    }
    // Previously there was a short-circuit here returning `joined` whenever it
    // contained any kanji, on the theory that kanji presence implied a trustworthy
    // join. It didn't: almost every join contains kanji from at least one
    // correctly-recognized segment, so the short-circuit fired nearly every time
    // and defeated allRecognized tracking — letting an adjacent *unrecognized*
    // segment's raw kana get silently concatenated in and shown as if the whole
    // sentence were confidently resolved (e.g. 行衛を仰手, 森崈ている, 賭場されない).
    return allRecognized ? joined : null;
  }

  // "自動区切り変更": a second candidate from a *differently-segmented*
  // reading of the same text, not just a different word choice for the same
  // segmentation — e.g. へんかんせいど is one whole compound dict entry
  // (→変換精度), but splitting it へんかん+せいど instead gives 返還+制度,
  // a genuinely different (and sometimes intended) parse. Two cases:
  // - primary collapsed the whole reading into one span: the curated
  //   ALT_SEG_WORDS whole-string split below.
  // - primary already split into multiple segments (the common case for any
  //   real sentence): findBoundaryDetourAlternate's edge-by-edge detour.
  //   Ordinary candidate cycling only ever varies word choice *within* the
  //   primary's own segment boundaries, so a wrong boundary itself (not just
  //   a wrong word for a correct segment) previously had no fallback here.
  findAlternateSegmentation(kana: string): string | null {
    if (kana.length < 4) { return null; }
    const primary = this.segment(kana);
    if (primary.length !== 1) { return this.findBoundaryDetourAlternate(kana, primary); }
    // Forcing the DP to merely avoid the whole-string span isn't enough — it
    // just finds whatever's next-cheapest overall, which can land on a split
    // point with no linguistic relation to the intended one (へんかんせいど ->
    // へん+かんせいど instead of へんかん+せいど). Look for an actual 2-morpheme
    // boundary instead: a position where *both* halves are themselves
    // recognized dictionary words, picking the cheapest such split.
    let bestSplit = -1;
    let bestCost = Infinity;
    let bestBalance = -1;
    for (let i = 2; i <= kana.length - 2; i++) {
      const left = kana.slice(0, i);
      const right = kana.slice(i);
      // inDict() alone is far too permissive here — dict.json lists some
      // obscure kanji reading for nearly every kana fragment, so almost any
      // split point would trivially pass and mostly produce garbage (checked
      // against a random sample of dictionary keys during development).
      // Require ALT_SEG_WORDS on *both* sides: a curated "this is a
      // genuinely common word" signal, not just "something maps to this".
      if (!KanaKanjiConverter.ALT_SEG_WORDS.has(left) || !KanaKanjiConverter.ALT_SEG_WORDS.has(right)) { continue; }
      const cost = this.getWordInfo(left)[0] + this.getWordInfo(right)[0];
      // Tiebreak toward the more balanced split: a 2-char/5-char split is
      // usually a short generic prefix cutting into a longer word by
      // coincidence, whereas equal-ish halves (4/3) are the real compound
      // boundary. Only applied when costs tie exactly.
      const balance = Math.min(i, kana.length - i);
      if (cost < bestCost || (cost === bestCost && balance > bestBalance)) {
        bestCost = cost;
        bestBalance = balance;
        bestSplit = i;
      }
    }
    if (bestSplit < 0) { return null; }
    const alt = [kana.slice(0, bestSplit), kana.slice(bestSplit)];
    const result = this.joinSegs(alt);
    if (result === null || result === kana) { return null; }
    return result;
  }

  // General case of the "自動区切り変更" idea above, for a primary segmentation
  // that's *already* multiple segments: the whole-string ALT_SEG_WORDS split
  // only ever helps when Viterbi collapsed everything into one span, so any
  // sentence long enough to naturally segment at all (i.e. almost every real
  // sentence) got zero benefit from it — a wrong boundary anywhere in the
  // middle of an ordinary multi-word sentence had no alternate to fall back
  // to; only the last segment's word choice was ever cyclable.
  //
  // Detours one primary-path edge at a time (Yen's-style single-edge detour,
  // not a full N-best DP rewrite): for each segment the DP actually chose,
  // re-run segment() with just that one span forbidden and see what it picks
  // instead. A bare cost-based detour alone reliably produces linguistically
  // meaningless splits (the exact failure the ALT_SEG_WORDS branch above was
  // built to avoid for the single-span case) — joinSegs()'s existing
  // allRecognized gate is reused here as the same hard quality filter,
  // rather than inventing a second one. Among detours that clear it, the
  // cheapest by the same getWordInfo()-sum metric the ALT_SEG_WORDS branch
  // already uses wins.
  private findBoundaryDetourAlternate(kana: string, primary: string[]): string | null {
    const primaryResult = this.joinSegs(primary);
    if (primaryResult === null) { return null; }
    const bounds: number[] = [0];
    for (const seg of primary) { bounds.push(bounds[bounds.length - 1] + seg.length); }
    let best: string[] | null = null;
    let bestResult = '';
    let bestCost = Infinity;
    for (let e = 0; e < primary.length; e++) {
      const start = bounds[e];
      const len = primary[e].length;
      const detour = this.segment(kana, [start, len]);
      if (detour.length === 0) { continue; }
      const detourResult = this.joinSegs(detour);
      // A detour that merely re-draws a boundary between two segments whose
      // joined *text* comes out identical either way (で+は vs では -- both
      // render "では") isn't a real alternative; comparing the segment
      // arrays themselves would wrongly accept it, since the arrays differ
      // even though nothing the user would see does.
      if (detourResult === null || detourResult === primaryResult || detourResult === kana) { continue; }
      let cost = 0;
      for (const seg of detour) { cost += this.getWordInfo(seg)[0]; }
      if (cost < bestCost) { bestCost = cost; best = detour; bestResult = detourResult; }
    }
    return best === null ? null : bestResult;
  }

  // Whole-sentence homophone alternatives for candidate positions 1+, track A.
  // The default engine used to offer only the LAST segment's variants
  // (updateCandidates' decompose branch) or the whole reading's katakana/kana,
  // so a homophone in any non-final word never appeared anywhere in the list:
  // はしをわたる led with 箸を渡る and never offered 橋を渡る; しゃしんをとった
  // could not reach 写真を取った. This mirrors track B's composeMozcCandidates:
  // swap ONE segment at a time to its other lookup candidates, keeping the rest
  // at their base auto-conversion, earliest segment first. Returns alternatives
  // only -- never the base candidate[0], which updateCandidates computes and
  // keeps unchanged (the corpus only regression-gates position 0). Empty for
  // track B, whose lookup() already routes through composeMozcCandidates.
  sentenceAlternatives(kana: string): string[] {
    if (KanaKanjiConverter.isMozcEngine()) { return []; }
    if (kana.length === 0) { return []; }
    let segs = this.segment(kana);
    // A whole-phrase single-span dict entry (しゃしんをとった) blocks per-word
    // alternatives; force a split (forbid the whole-string span, same detour
    // mechanism findBoundaryDetourAlternate uses) so its component words can
    // still contribute homophones. Only for readings long enough to be a
    // phrase, and only if the forced split actually produces multiple pieces.
    let forcedSplit = false;
    if (segs.length === 1 && kana.length >= 4) {
      const forced = this.segment(kana, [0, kana.length]);
      if (forced.length > 1) { segs = forced; forcedSplit = true; }
    }
    if (segs.length <= 1) {
      const out: string[] = [];
      const cands = this.lookup(kana);
      for (let i = 1; i < cands.length; i++) {
        const c = cands[i];
        if (c === kana || KanaKanjiConverter.isSymbolOnly(c)) { continue; }
        out.push(c);
      }
      return out;
    }
    const chosen: string[] = segs.map((s: string, i: number) => this.autoConvert(s, segs[i + 1], segs[i - 1]));
    const out: string[] = [];
    // When we forced a split of a whole-phrase entry, the forced parse's own
    // base rendering (写真を取った for しゃしんをとった, distinct from the entry's
    // canonical 写真を撮った at position 0) is itself a useful alternative --
    // emit it before the per-segment swaps. Deduped against position 0 in
    // updateCandidates. Not needed for a naturally multi-segment reading,
    // whose base parse already IS position 0.
    if (forcedSplit) {
      const base = chosen.join('');
      if (!KanaKanjiConverter.isSymbolOnly(base)) { out.push(base); }
    }
    const MAX_ALTS_PER_SEG = 3;
    const MAX_TOTAL = 12;
    for (let i = 0; i < segs.length && out.length < MAX_TOTAL; i++) {
      // Skip particles/auxiliaries kept as kana: their "homophones" are kanji
      // homographs of a grammatical word (は→歯/葉, に→荷/似), wrong in the slot.
      if (KanaKanjiConverter.FUNCTION_WORDS[segs[i]] || chosen[i] === segs[i]) { continue; }
      const pool = this.lookup(segs[i]);
      const prefix = chosen.slice(0, i).join('');
      const suffix = chosen.slice(i + 1).join('');
      let added = 0;
      for (let j = 0; j < pool.length && added < MAX_ALTS_PER_SEG && out.length < MAX_TOTAL; j++) {
        const alt = pool[j];
        if (alt === chosen[i] || alt === segs[i] || KanaKanjiConverter.isSymbolOnly(alt)) { continue; }
        const cand = prefix + alt + suffix;
        if (out.indexOf(cand) < 0) { out.push(cand); added++; }
      }
    }
    return out;
  }

  private static contextRerank(reading: string, cands: string[]): string[] {
    const buffer = KanaKanjiConverter.contextBuffer;
    if (buffer.length === 0) { return cands; }
    const scores: number[] = [];
    let hasSignal = false;
    for (let i = 0; i < cands.length; i++) {
      const key = reading + '|' + cands[i];
      const triggers = CONTEXT_HINTS[key];
      let score = 0;
      if (triggers) {
        for (const ctx of buffer) {
          for (const trigger of triggers) {
            if (ctx.indexOf(trigger) >= 0) { score += 1; }
          }
        }
      }
      scores.push(score);
      if (score > 0) { hasSignal = true; }
    }
    if (!hasSignal) { return cands; }
    // Stable insertion sort descending by score
    const order: number[] = [];
    for (let i = 0; i < cands.length; i++) { order.push(i); }
    for (let i = 1; i < order.length; i++) {
      const pivot = order[i];
      let j = i - 1;
      while (j >= 0 && scores[order[j]] < scores[pivot]) {
        order[j + 1] = order[j];
        j -= 1;
      }
      order[j + 1] = pivot;
    }
    const result: string[] = [];
    for (const idx of order) { result.push(cands[idx]); }
    return result;
  }

  private lookupCore(kana: string, fromNorm: boolean = false): string[] {
    // 読みの揺れ (ず/じ で打たれた づ/ぢ 語) の正規化: 正しい読みの漢字候補を
    // 先頭に取り込む。誤り読みそのままの候補も末尾に残す（別語の可能性に配慮）。
    if (!fromNorm) {
      const corrected = MISTYPE_READINGS[kana];
      if (corrected !== undefined) {
        const correctCands = this.lookup(corrected, true)
          .filter((c: string) => KanaKanjiConverter.hasKanjiChar(c));
        if (correctCands.length > 0) {
          const own = this.lookup(kana, true).filter((c: string) => !correctCands.includes(c));
          return [...correctCands, ...own];
        }
      }
    }
    const _col = KanaKanjiConverter.COLLOQUIAL_KANA[kana];
    if (_col !== undefined && !fromNorm) {
      const _rest = this.lookup(kana, true).filter((c: string) => c !== _col);
      return [_col, ..._rest];
    }
    // 口語縮約形 → 標準形で再帰検索し、結果を口語形に変換して先頭候補にする（深さ1限定）。
    if (!fromNorm) {
      const colSuf = KanaKanjiConverter.COLLOQUIAL_SUFFIXES;
      const colStd = KanaKanjiConverter.COLLOQUIAL_STANDARD;
      for (let ci = 0; ci < colSuf.length; ci++) {
        const suffixColloquial = colSuf[ci];
        const norm = colStd[ci];
        if (kana.endsWith(suffixColloquial)) {
          const stem = kana.slice(0, kana.length - suffixColloquial.length);
          const normalizedKana = stem + norm;
          const normalizedCands = this.lookup(normalizedKana, true);
          const colloquial: string[] = [];
          for (const c of normalizedCands) {
            if (/[一-鿿]/.test(c) && c.endsWith(norm)) {
              colloquial.push(c.slice(0, c.length - norm.length) + suffixColloquial);
            }
          }
          if (colloquial.length > 0) {
            const rest = normalizedCands.filter((c: string) => !colloquial.includes(c));
            return KanaKanjiConverter.boostCounterWords([...colloquial, ...rest]);
          }
        }
      }
    }

    const entry = DICTIONARY[kana];
    const ext = KanaKanjiConverter.supplementaryDict[kana];
    const user = KanaKanjiConverter.userDict[kana];
    const global = KanaKanjiConverter.globalDict[kana];
    const kata = KanaKanjiConverter.toKatakana(kana);
    let cands: string[];

    if (entry && entry.length > 0) {
      cands = [...entry];
      if (ext && ext.length > 0) {
        for (const c of ext) {
          if (!cands.includes(c)) { cands.push(c); }
        }
      }
      if (kata !== kana && !cands.includes(kata)) { cands.push(kata); }
      if (!cands.includes(kana)) { cands.push(kana); }
    } else if (ext && ext.length > 0) {
      cands = [...ext];
      if (kata !== kana && !cands.includes(kata)) { cands.push(kata); }
      if (!cands.includes(kana)) { cands.push(kana); }
      // Loanwords: promote katakana to the front — but ONLY when the dictionary
      // itself authored a katakana form for this reading (a real loanword like
      // ぱそこん→パソコン). Native all-kana words (どうしよう, なんとか) have no
      // authored katakana and must keep their as-typed hiragana on top instead
      // of an auto-generated katakana transcription.
      const hasKanji = cands.some((c: string) => /[一-鿿]/.test(c));
      const dictHasKatakana = ext.some((c: string) => KanaKanjiConverter.isPureKatakana(c));
      // ...but not when the dictionary ALSO authored the plain hiragana form:
      // that marks a word writable both ways (slang like わろた/ワロタ), where
      // the as-typed hiragana is the better default. A true loanword lists only
      // its katakana (パソコン), never the ぱそこん hiragana.
      const dictHasHiragana = ext.some((c: string) => c === kana);
      if (!hasKanji && dictHasKatakana && !dictHasHiragana && kata !== kana && cands[0] !== kata) {
        cands = [kata, ...cands.filter((c: string) => c !== kata)];
      }
    } else if ((user && user.length > 0) || (global && global.length > 0)) {
      // Only a registered dictionary (user/global) knows this reading.
      cands = [];
      if (kata !== kana) { cands.push(kata); }
      if (!cands.includes(kana)) { cands.push(kana); }
      // user leads global; both prepended ahead of the katakana/kana fallback.
      const withGlobal = KanaKanjiConverter.withRegisteredWords(global, cands);
      const withUserOnly = KanaKanjiConverter.withRegisteredWords(user, withGlobal);
      // global/user dicts are scraped and can lead with sentence-fragment or
      // markup garbage (は、日本の…藍屋球). filterCandidates never runs on this
      // early-return path, so drop artifacts here too — keeping the list if
      // everything was filtered out, to never return empty.
      let gClean = KanaKanjiConverter.cleanArtifacts(withUserOnly);
      if (gClean.length === 0) { gClean = withUserOnly; }
      return KanaKanjiConverter.boostCounterWords(gClean);
    } else {
      // Not in any dict: try Viterbi segment→convert→join first, then katakana fallback.
      const fallback = kata !== kana ? [kana, kata] : [kana];
      if (!fromNorm) {
        const joined = this.segmentJoinFallback(kana);
        if (joined !== null) {
          // Multi-morpheme phrase recognized by the segmenter (e.g. してね = して+ね)
          // always outranks a blind katakana guess, even when joined has no kanji and
          // happens to equal the plain kana form itself.
          const rest = fallback.filter((c: string) => c !== joined);
          return KanaKanjiConverter.boostCounterWords([joined, ...rest]);
        }
      }
      return KanaKanjiConverter.boostCounterWords(fallback);
    }

    const filtered = KanaKanjiConverter.filterCandidates(kana, cands);
    // global folds in as extra candidates (see appendRegisteredWords) rather
    // than jumping the queue, then known-common words get pulled back to the
    // front ahead of whatever obscure entry either dict source led with, and
    // finally the user's own learned/registered choices — the most explicit
    // signal of intent — take priority over all of the above.
    const withGlobal = KanaKanjiConverter.appendRegisteredWords(global, filtered);
    const boosted = KanaKanjiConverter.boostCommonWords(withGlobal);
    const ordered = KanaKanjiConverter.applyLearning(kana, boosted);
    const withUser = KanaKanjiConverter.withRegisteredWords(user, ordered);
    let result = KanaKanjiConverter.contextRerank(kana, withUser);
    // Function words (particles/auxiliaries) must stay as hiragana by default
    // even after global/user overrides, unless the user has explicitly learned a kanji form.
    if (KanaKanjiConverter.FUNCTION_WORDS[kana] && result[0] !== kana) {
      const hasLearned = KanaKanjiConverter.learned[kana] &&
                         Object.keys(KanaKanjiConverter.learned[kana]).length > 0;
      if (!hasLearned) {
        const rest = result.filter((c: string) => c !== kana);
        result = [kana, ...rest];
      }
    }
    result = KanaKanjiConverter.postParticleBoost(result);
    result = KanaKanjiConverter.boostCounterWords(result);
    // Prefer the as-typed hiragana over an odd leading candidate in two cases:
    if (result.length > 0 && result[0] !== kana && result.includes(kana)) {
      const top = result[0];
      const authored = entry ?? ext ?? [];
      // (a) mixedKana: leading form mixes hiragana+katakana with no kanji, e.g.
      //     "マジか" (=マジ+か). A raw script-mix of the reading is never a good
      //     default. Deliberately does NOT touch pure-symbol leads (かっこ→"()"
      //     is an intended shortcut) or latin-bearing forms (Tシャツ).
      // (b) writableBothWays: nothing converts to kanji and the dictionary
      //     itself authored BOTH a katakana and the plain hiragana — a word
      //     writable both ways, e.g. slang わろた/ワロタ or mimetic どきどき.
      //     A genuine loanword (バター, リスク, ステーキ…) also lists its own
      //     bare reading as a defensive fallback candidate, which used to
      //     trip this same check and wrongly demote the katakana it should
      //     lead with — restrict to reduplicated (AABB) readings, the shape
      //     that actually marks a native mimetic/doubled word, so borrowed
      //     words are no longer caught by that false positive.
      // katakana-stem + native auxiliary/particle (アクセスできる, ネットで,
      // アプリを…) is a legitimate, common construction — not an accidental
      // script mix like マジか — so it's exempted from the mixedKana check
      // below. Restricted to a single trailing particle/auxiliary (not just
      // "any hiragana suffix") so genuine mixed-script garbles are still
      // caught.
      // Also covers the productive katakana-stem "-る verb" conjugation
      // pattern (ダブる/サボる/バグる/ミスる → ダブって/サボった/バグらない…),
      // another completely standard construction, not a script-mix accident.
      // Also covers the equally productive katakana-noun+する pattern
      // (メモする/コピーする/シェアする → メモした/メモして/メモします…).
      const katakanaStemAux = /^[ァ-ヶー]+(できる|できた|できます|できません|できて|できない|できなかった|する|した|します|しません|して|しない|しなかった|していた|している|していない|しておいた|しておく|しました|してください|は|が|を|に|で|と|も|の|へ|や|から|まで|って|った|る|らない|れば|り|れて|れた)$/.test(top);
      const mixedKana = !KanaKanjiConverter.hasKanjiChar(top) &&
          /[ぁ-ん]/.test(top) && /[ァ-ヶ]/.test(top) && !katakanaStemAux;
      const noKanjiAnywhere = !result.some((c: string) => KanaKanjiConverter.hasKanjiChar(c));
      const writableBothWays = noKanjiAnywhere &&
          KanaKanjiConverter.isReduplicated(kana) &&
          authored.indexOf(kana) >= 0 &&
          authored.some((c: string) => KanaKanjiConverter.isPureKatakana(c));
      if (mixedKana || writableBothWays) {
        result = [kana, ...result.filter((c: string) => c !== kana)];
      }
    }
    // Compound verbs (V連用形+V: 立て直す, 走り回る, 申し込む, 読み終わる…)
    // are productive and dict.json often lists the bare kana reading first,
    // so they convert to kana by default even though the kanji form is almost
    // always wanted. When the reading ends in one of the closed set of
    // second-verb suffixes AND a kanji candidate spells this exact reading in
    // okurigana (its trailing kana == the reading's), promote that kanji form.
    // Restricted to that closed suffix set so kana-convention words
    // (ありがとう, ございます, ちょっと…) are never touched.
    if (result.length > 1 && result[0] === kana && kana.length >= 4 &&
        KanaKanjiConverter.endsWithCompoundVerbSuffix(kana)) {
      // Promote the first kanji-bearing candidate whose okurigana ending (its
      // final kana) matches the reading's — for a compound verb that final
      // char always agrees (…直す/…回る/…込んだ), and it rules out an
      // unrelated homophone. No subsequence check: internal kanji (立て直す =
      // て…す, non-contiguous) would otherwise never match.
      const kanjiIdx = result.findIndex((c: string) =>
        KanaKanjiConverter.hasKanjiChar(c) &&
        c[c.length - 1] === kana[kana.length - 1]);
      if (kanjiIdx > 0) {
        const picked = result[kanjiIdx];
        result = [picked, ...result.filter((c: string) => c !== picked)];
      }
    }
    // Bare single-kanji lead on an inflected verb/adjective reading is a
    // dict.json artifact: those entries hold a kanji-dictionary-style list of
    // single characters (おさめる→乂/乱/収…, のぞむ→希/望/朢…) with no
    // okurigana, so 乂/希 lead over the real 収める/望む that only global_dict
    // carries. A single kanji can never spell a 3+-mora inflected verb, so
    // when result[0] is one and the reading ends in an inflection kana,
    // promote the first proper okurigana form (kanji + matching final kana).
    if (result.length > 1 && kana.length >= 3 &&
        KanaKanjiConverter.INFLECTION_ENDINGS.indexOf(kana[kana.length - 1]) >= 0 &&
        KanaKanjiConverter.hasKanjiChar(result[0]) && result[0].length === 1) {
      // Only promote an okurigana form that a *curated* source (global_dict or
      // the inline DICTIONARY) authored — dict.json's scrape also fabricates
      // garbage okurigana on obscure kanji (乂める/尹める/甸める for おさめる),
      // which would otherwise be picked as the first okurigana-ending match.
      const curated = new Set<string>([...(global ?? []), ...(entry ?? [])]);
      const okuriIdx = result.findIndex((c: string) =>
        c.length >= 2 && KanaKanjiConverter.hasKanjiChar(c) &&
        c[c.length - 1] === kana[kana.length - 1] &&
        /[ぁ-ん]$/.test(c) && curated.has(c));
      if (okuriIdx > 0) {
        const picked = result[okuriIdx];
        result = [picked, ...result.filter((c: string) => c !== picked)];
      }
    }
    // Final safety net: global/user dict entries are merged in after
    // filterCandidates already ran, so a markup artifact contributed only by
    // one of those (e.g. global_dict's own "[[錦]]"/"{{w|甲賀}}") would
    // otherwise slip through untouched. Only drop them if something clean
    // remains — never return an empty candidate list.
    let clean = KanaKanjiConverter.cleanArtifacts(result);
    if (clean.length === 0) { clean = result; }
    return clean;
  }

  // じ/ず と ぢ/づ は現代語ではほぼ同音のため、辞書側が本来の表記（ぢ/づ）
  // でしか登録していない語は、より打たれやすい じ/ず 側から永久に引けない
  // （例: 「みじか」で「身近」が出ない — 辞書は「みぢか」にしかない）。
  // 読みに じ/ず が含まれる場合のみ、該当箇所を ぢ/づ に置き換えた全ての
  // 組み合わせを試し、そちらだけが持つ漢字候補を拾う。MISTYPE_READINGS
  // （動詞活用の決め打ちリスト）と違い辞書全体を自動的にカバーする一般ルール。
  private static dakutenVariants(kana: string): string[] {
    if (!/[じず]/.test(kana)) { return []; }
    const positions: number[] = [];
    for (let i = 0; i < kana.length; i++) {
      if (kana[i] === 'じ' || kana[i] === 'ず') { positions.push(i); }
    }
    const n = positions.length;
    const variants: string[] = [];
    for (let mask = 1; mask < (1 << n); mask++) {
      const chars = kana.split('');
      for (let b = 0; b < n; b++) {
        if (mask & (1 << b)) {
          const idx = positions[b];
          chars[idx] = chars[idx] === 'じ' ? 'ぢ' : 'づ';
        }
      }
      variants.push(chars.join(''));
    }
    return variants;
  }

  // Public entry point. Delegates to lookupCore for the actual conversion, then
  // appends emoji/kaomoji for the reading. Done here (not inside lookupCore) so
  // it applies on *every* return path — lookupCore returns early for
  // global-only readings, colloquial forms, and out-of-dict fallbacks, and
  // those would otherwise miss the pictographs. Skipped for fromNorm (internal
  // recursive) calls so intermediate results don't accrue duplicates.
  lookup(kana: string, fromNorm: boolean = false): string[] {
    // Track B bypasses lookupCore() and everything below (dakuten
    // enrichment, EMOJI_MAP/KAOMOJI_MAP) entirely -- all of that is
    // track-A-specific hand-tuning layered onto the hand-built dictionary,
    // and mozc data is meant to stand on its own (see `engine` field
    // comment). segment()/joinSegs()/findAlternateSegmentation() all call
    // through this same lookup() entry point, so this one dispatch makes
    // every caller engine-aware without touching their own code.
    if (KanaKanjiConverter.isMozcEngine()) { return this.lookupMozc(kana); }
    const base = this.lookupCore(kana, fromNorm);
    if (fromNorm) { return base; }
    let result = base;
    // Dakuten-confusion enrichment (じ/ず ⇄ ぢ/づ). Skipped for function words —
    // their kana form is a deliberate grammatical choice, not a coverage gap.
    if (!KanaKanjiConverter.FUNCTION_WORDS[kana]) {
      const variants = KanaKanjiConverter.dakutenVariants(kana);
      if (variants.length > 0) {
        const baseHasKanji = base.some((c: string) => KanaKanjiConverter.hasKanjiChar(c));
        const extra: string[] = [];
        for (const v of variants) {
          const vCands = this.lookupCore(v, true);
          for (const c of vCands) {
            if (KanaKanjiConverter.hasKanjiChar(c) && !base.includes(c) && !extra.includes(c)) {
              extra.push(c);
            }
          }
        }
        if (extra.length > 0) {
          result = baseHasKanji ? [...base, ...extra] : [...extra, ...base];
        }
      }
    }
    const emojis = EMOJI_MAP[kana];
    const kaomoji = KAOMOJI_MAP[kana];
    if (emojis === undefined && kaomoji === undefined) { return result; }
    const withExtra = [...result];
    const push = (arr: string[] | undefined): void => {
      if (arr === undefined) { return; }
      for (const e of arr) {
        if (!withExtra.includes(e)) { withExtra.push(e); }
      }
    };
    push(emojis);
    push(kaomoji);
    return withExtra;
  }

  // Track B's lookup: a plain read from mozc_dict.json, ascending mozc cost
  // order, no track-A special-casing (colloquial/mistype normalization,
  // COLLOCATION_HINTS, dakuten enrichment, emoji/kaomoji). Falls back to
  // [katakana-if-different, kana] when mozc has no entry, matching the same
  // "always return something usable" shape lookupCore's own fallback keeps.
  //
  // If this exact reading was just resolved to a specific sense by the most
  // recent segment() call on this instance (mozcLastHints), that sense's
  // surface leads the returned candidates -- e.g. for a reading like し that
  // has both a する-stem sense and an unrelated 死 sense, this is how the
  // sense segment()'s DP actually picked (based on real context) wins over
  // mozcDict[kana][0] (whichever surface is cheapest for the reading with no
  // context at all).
  private lookupMozc(kana: string): string[] {
    const entry = KanaKanjiConverter.getMozcDictSurfaces(kana);
    const hint = this.mozcLastHints.get(kana);
    let list: string[];
    if (kana === this.mozcLastInput && this.mozcLastSegs.length > 1) {
      // Whole just-segmented input: compose real alternatives from the
      // winning path instead of returning whatever junk single entry the
      // raw dictionary happens to have for the concatenated reading
      // (とった -> [トッタ] was the whole list before this).
      list = this.composeMozcCandidates();
    } else if (hint !== undefined) {
      if (entry && entry.length > 0) {
        list = [hint, ...entry.filter((c: string) => c !== hint)];
      } else {
        list = [hint];
      }
    } else if (entry && entry.length > 0) {
      list = entry;
    } else {
      const kata = KanaKanjiConverter.toKatakana(kana);
      if (kata === kana) {
        list = [kana];
      } else {
        // Unknown reading: katakana leads only when the reading carries a
        // long-vowel mark ー (a strong loanword signal -- こんさーと etc.);
        // otherwise plain kana leads. The old unconditional katakana-first
        // fallback turned ordinary casual contractions the dictionary happens
        // to miss (それって, あれって, ほんまに) into gratuitous katakana
        // (ソレッテ...) at the top of the candidate list.
        list = kana.indexOf('ー') >= 0 ? [kata, kana] : [kana, kata];
      }
    }
    // Same user-intent layering as track A's lookupCore (and in the same
    // priority order): the user's learned candidate choices outrank raw
    // dictionary/DP-hint order, and explicitly registered user-dictionary
    // words (including POS-expanded conjugated forms, see
    // ConjugationEngine.ets) outrank everything. Track B previously
    // consulted neither -- so a homophone the user had corrected a hundred
    // times (or even explicitly registered) kept defaulting to mozc's
    // statistical pick. This is exactly the layer real mozc leans on for
    // same-class homophones (撮った vs 取った), where POS statistics alone
    // genuinely cannot decide.
    //
    // Unlike track A's applyLearning (which only reorders candidates already
    // in the list), learned surfaces absent from the list are PREPENDED:
    // track B's per-reading lists genuinely lack many valid conversions
    // (e.g. a surface the user previously built through 文節変換), and a
    // choice the user actually made before is valid by construction.
    const counts = KanaKanjiConverter.learned[kana];
    if (counts && Object.keys(counts).length > 0) {
      const missing = Object.keys(counts)
        .filter((c: string) => list.indexOf(c) < 0)
        .sort((a: string, b: string) => (counts[b] ?? 0) - (counts[a] ?? 0));
      list = [...missing, ...list];
    }
    const ordered = KanaKanjiConverter.applyLearning(kana, list);
    return KanaKanjiConverter.withRegisteredWords(KanaKanjiConverter.userDict[kana], ordered);
  }

  // Builds the candidate list for the whole most-recently-segmented input
  // by composing the winning path's per-segment choices, then generating
  // alternatives that swap ONE segment at a time to its other same-reading
  // surfaces (取った -> 撮った/獲った..., ordered by each segment's own
  // candidate ranking). This is the poor-IME's n-best: real mozc derives
  // whole-sentence alternatives from its lattice; the class-keyed DP here
  // collapses same-class homophones into one state, so the lattice alone
  // cannot enumerate them -- but the per-segment dictionaries still know
  // every surface, and one-segment-at-a-time swaps cover the dominant
  // real-world correction pattern (exactly one word wrong).
  private composeMozcCandidates(): string[] {
    const segs = this.mozcLastSegs;
    const chosen: string[] = [];
    for (let i = 0; i < segs.length; i++) {
      const hint = this.mozcLastHints.get(segs[i]);
      if (hint !== undefined) {
        chosen.push(hint);
      } else {
        const e = KanaKanjiConverter.getMozcDictSurfaces(segs[i]);
        if (e && e.length > 0) {
          chosen.push(e[0]);
        } else {
          const kata = KanaKanjiConverter.toKatakana(segs[i]);
          chosen.push(segs[i].indexOf('ー') >= 0 ? kata : segs[i]);
        }
      }
    }
    const base = chosen.join('');
    const out: string[] = [base];
    const MAX_ALTS_PER_SEG = 4;
    const MAX_TOTAL = 24;
    for (let i = 0; i < segs.length && out.length < MAX_TOTAL; i++) {
      const e = KanaKanjiConverter.getMozcDictSurfaces(segs[i]);
      if (!e || e.length < 2) { continue; }
      const prefix = chosen.slice(0, i).join('');
      const suffix = chosen.slice(i + 1).join('');
      let added = 0;
      for (let j = 0; j < e.length && added < MAX_ALTS_PER_SEG && out.length < MAX_TOTAL; j++) {
        if (e[j] === chosen[i]) { continue; }
        const cand = prefix + e[j] + suffix;
        if (out.indexOf(cand) < 0) {
          out.push(cand);
          added++;
        }
      }
    }
    // Full-katakana and as-typed forms as final fallbacks, same contract as
    // every other candidate list in this app.
    const kata = KanaKanjiConverter.toKatakana(this.mozcLastInput);
    if (out.indexOf(kata) < 0) { out.push(kata); }
    if (out.indexOf(this.mozcLastInput) < 0) { out.push(this.mozcLastInput); }
    return out;
  }

  // Closed set of compound-verb second elements (as they appear at the end of
  // a reading, across their common conjugations). Used only to promote the
  // kanji spelling of a productive compound verb over its kana-lead dict entry.
  private static readonly COMPOUND_VERB_SUFFIXES: string[] = [
    'なおす', 'なおし', 'なおした', 'なおして', 'なおせる',
    'まわる', 'まわった', 'まわって', 'まわり', 'まわす', 'まわした',
    'はじめる', 'はじめた', 'はじめて', 'はじまる', 'はじまった',
    'おわる', 'おわった', 'おわって', 'おわり',
    'つづける', 'つづけた', 'つづけて', 'つづく', 'つづいた',
    'だす', 'だした', 'だして',
    'こむ', 'こんだ', 'こんで', 'こみ',
    'あう', 'あった', 'あって', 'あい',
    'かえす', 'かえした', 'かえして',
    'つける', 'つけた', 'つけて',
    'あげる', 'あげた', 'あげて',
    'かける', 'かけた', 'かけて',
    'こなす', 'こなした',
    'すぎる', 'すぎた', 'すぎて',
    'なれる', 'なれた', 'なれて',
    'つづり',
  ];

  // Final kana of an inflected verb/adjective surface (godan/ichidan dict form
  // endings る/す/く/つ/ぬ/ふ/む/ぐ/う/ぶ and the adjective い). Used to detect
  // that a reading is an inflected word whose proper surface carries okurigana.
  private static readonly INFLECTION_ENDINGS: string = 'るすくつぬむぐうぶい';

  private static endsWithCompoundVerbSuffix(kana: string): boolean {
    for (const suf of KanaKanjiConverter.COMPOUND_VERB_SUFFIXES) {
      if (kana.length > suf.length && kana.endsWith(suf)) { return true; }
    }
    return false;
  }

  // Returns the best single conversion: keeps kana for function words, else first lookup candidate.
  // nextSeg (the segment immediately following this one in the caller's
  // segmentation, if any) lets a small set of homograph readings pick the
  // verb-stem sense over lookup()'s default top candidate when a
  // continuation aux follows -- e.g. はなし+てる is 話して(い)る (話し, the
  // renyou stem of 話す), not the bare noun 話 that lookup('はなし') ranks
  // first on its own. Same shape of fix as joinSegs' あい/すい special case
  // below, different call site: joinSegs only runs for readings that
  // resolve through the whole-string lookup fallback, while this covers the
  // per-segment reconstruction path used when that fallback doesn't fire
  // (e.g. an earlier segment in a long casual sentence isn't independently
  // recognized, so lookup() never reaches segmentJoinFallback for it).
  autoConvert(kana: string, nextSeg?: string, prevSeg?: string): string {
    // Track B: the DP already picked a context-aware sense for this segment
    // (threaded through mozcLastHints into lookup()'s top candidate), so go
    // straight there. Every override below this line is track-A hand-tuning
    // (FUNCTION_WORDS kana-locking, は→歯, はなし→話し, ...) that must NOT
    // leak into track B's composition: e.g. FUNCTION_WORDS['ね']/['でる']/
    // ['たり'] would force kana for what mozc's DP correctly resolved as
    // 寝/出る/足り (verb senses), silently overwriting the statistical
    // engine's actual decision with track A's opinions.
    if (KanaKanjiConverter.isMozcEngine()) {
      return this.lookup(kana)[0];
    }
    // は directly before を: see joinSegs' matching special case for why --
    // checked before the FUNCTION_WORDS short-circuit below, which would
    // otherwise always keep a bare は in kana regardless of context.
    if (kana === 'は' && nextSeg === 'を') {
      return '歯';
    }
    if (KanaKanjiConverter.FUNCTION_WORDS[kana]) {
      return kana;
    }
    if (kana === 'はなし' && nextSeg !== undefined && /^(てる|てい|てた|た|ます|ませ)/.test(nextSeg)) {
      return '話し';
    }
    // なん directly before ちゃう: see joinSegs' matching special case for why.
    if (kana === 'なん' && nextSeg !== undefined && nextSeg.startsWith('ちゃう')) {
      return 'なん';
    }
    // やすい directly after another segment: see joinSegs' matching special
    // case for why.
    if (kana === 'やすい' && prevSeg !== undefined &&
        !KanaKanjiConverter.CASE_PARTICLES.has(prevSeg) &&
        !KanaKanjiConverter.FW_CLASS_MAP[prevSeg]) {
      return 'やすい';
    }
    // てきた/てきて/き(ちゃ...): see joinSegs' matching special case for why.
    if (prevSeg !== undefined && prevSeg.length > 1 && /[てで]$/.test(prevSeg) &&
        ((kana === 'きた' || kana === 'きて') ||
         (kana === 'き' && nextSeg !== undefined && nextSeg.startsWith('ちゃ')))) {
      return kana;
    }
    // いった after て/で: see joinSegs' matching special case for why.
    if (kana === 'いった' && prevSeg !== undefined && prevSeg.length > 1 &&
        /[てで]$/.test(prevSeg)) {
      return '行った';
    }
    // なくなった after れ: see joinSegs' matching special case for why.
    if (kana === 'なくなった' && prevSeg !== undefined && prevSeg.endsWith('れ')) {
      return kana;
    }
    return this.lookup(kana)[0];
  }

  // Convert hiragana to katakana (U+3041-U+3096 → U+30A1-U+30F6, offset 0x60).
  static toKatakana(hiragana: string): string {
    let result = '';
    for (let i = 0; i < hiragana.length; i++) {
      const code = hiragana.charCodeAt(i);
      result += (code >= 0x3041 && code <= 0x3096)
        ? String.fromCharCode(code + 0x60)
        : hiragana[i];
    }
    return result;
  }

  // dict.json was scraped from Wikipedia/Wiktionary and a few hundred entries
  // still carry raw wiki markup or disambiguation glosses instead of plain
  // Japanese text — e.g. "[[謎]]" (wikilink), "{{ruby|区々|まちまち}}"
  // (template), "'''祭'''（り）" (bold + optional-okurigana notation), or
  // "中国（地方）" (a parenthetical gloss disambiguating a sense, not part of
  // the actual word). None of these are valid to insert as-is, and the plain
  // form is always available separately in the same candidate list, so they're
  // dropped rather than just deprioritized.
  private static isMarkupArtifact(c: string): boolean {
    if (/\[\[|\]\]/.test(c)) { return true; }       // [[wikilink]]
    if (/\{\{|\}\}/.test(c)) { return true; }        // {{template}}
    if (/'''/.test(c)) { return true; }              // '''bold'''
    if (/<[a-zA-Z/]/.test(c)) { return true; }       // stray <html> tag
    if (/&#|&amp;|&lt;|&gt;|&quot;/.test(c)) { return true; } // HTML entity (&#91; …)
    if (/[ぁ-ゖァ-ヶ一-鿿]\s*,/.test(c)) { return true; } // ASCII comma after a
                                                     // Japanese char = two merged
                                                     // surface forms (選択, 撰択);
                                                     // recoverFragment keeps the
                                                     // first. Digit commas (1,000)
                                                     // are unaffected.
    if (/[、。]/.test(c)) { return true; }            // Japanese punctuation: a
                                                     // single dictionary surface
                                                     // never contains 、/。, so
                                                     // this is a scraped sentence
                                                     // fragment (は、日本の…藍屋球)
    if (/[;；][0-9]|[0-9]{2};/.test(c)) { return true; } // stray entity remnants "91;" "1;2"
    if (/^["']/.test(c)) { return true; }            // leading stray quote markup
    if (/[:：|｜]/.test(c)) { return true; }          // colon / pipe anywhere = wiki
                                                     // or annotation markup
                                                     // (w:漢口|漢口, 当て字:流石,
                                                     // 稀:沙) — never in a real word
    if (/[（(【「『]$/.test(c)) { return true; }      // dangling open bracket at end (藍屋球（)
    if (/^[）)】」』]/.test(c)) { return true; }      // dangling close bracket at start
    if (/^[／/]/.test(c)) { return true; }           // leading slash (／単位取得後退学)
    // Unmatched parenthesis => scraped sentence fragment: 毒性）試験, 須賀川市),
    // "ility）または老成魚". Balanced parens are legit (（財）, 西鉄福岡（天神）駅,
    // O(n)) so only an open/close-count mismatch is flagged.
    const fwParen = (c.split('（').length) - (c.split('）').length);
    const hwParen = (c.split('(').length) - (c.split(')').length);
    if (fwParen !== 0 || hwParen !== 0) { return true; }
    if (/[#＃]/.test(c) && /[一-鿿]/.test(c)) { return true; } // wiki section link
                                                     // (…登場人物#三藁); keeps C#
                                                     // and other latin-only forms
    if (/[「」『』]/.test(c)) { return true; }          // quote marks anywhere: a
                                                     // single surface never quotes
                                                     // (湖で行う水浴」を湖水浴)
    if (/[【】〖〗]/.test(c)) { return true; }          // lenticular brackets = dict
                                                     // notation (【煌びやか】,
                                                     // 【碌でなし・陸で無し】)
    // Multi-word English phrase (all ASCII, has a letter AND a space), e.g.
    // "Academic Overview", "Access Control", "Art Nouveau" — scraped English
    // glosses that leaked in as candidates. Never valid Japanese output. Guarded
    // to ASCII-only so Japanese candidates (9月, DLする, Tシャツ) are untouched,
    // and to require a space so single acronyms (SNS, OK, DL) are kept.
    if (/^[\x20-\x7E]+$/.test(c) && /[A-Za-z]/.test(c) && /\s/.test(c)) { return true; }
    // Trailing short parenthetical gloss/optional-okurigana, e.g. 長持（ち）,
    // 中国（地方）, 関（せき）— real words don't end in a bare "（…）" like this.
    if (/^.+（[^（）]{1,6}）$/.test(c)) { return true; }
    return false;
  }

  // Strip DANGLING brackets from a scraped candidate so a clean word buried
  // inside can be recovered instead of dropped: 化学結合（ -> 化学結合,
  // 背泳」 -> 背泳, 藍屋球（ -> 藍屋球. Only removes brackets that are dangling
  // (an open bracket at the very end, a close bracket at the very start, or a
  // close/open with no partner), so balanced forms (（財）, O(n),
  // 西鉄福岡（天神）駅) are never altered. Only ever applied to candidates that
  // are already classified as markup, so legit candidates never reach it.
  private static recoverFragment(c: string): string {
    // Two merged surface forms "選択, 撰択" -> keep the first before the comma.
    let s = c.replace(/\s*,.*$/, '');
    for (let i = 0; i < 8 && s.length > 0; i++) {
      const opens = (s.split('（').length - 1) + (s.split('(').length - 1)
        + (s.split('「').length - 1) + (s.split('『').length - 1) + (s.split('【').length - 1);
      const closes = (s.split('）').length - 1) + (s.split(')').length - 1)
        + (s.split('」').length - 1) + (s.split('』').length - 1) + (s.split('】').length - 1);
      const last = s[s.length - 1];
      const first = s[0];
      if (/[（(「『【]/.test(last)) { s = s.slice(0, -1); continue; }            // trailing open = dangling
      if (/[）)」』】]/.test(last) && closes > opens) { s = s.slice(0, -1); continue; } // unmatched trailing close
      if (/[）)」』】]/.test(first)) { s = s.slice(1); continue; }               // leading close = dangling
      if (/[（(「『【]/.test(first) && opens > closes) { s = s.slice(1); continue; }  // unmatched leading open
      break;
    }
    return s;
  }

  // Filter markup artifacts, but first try to recover a clean word from a
  // doomed candidate by stripping dangling brackets. Legit candidates are
  // returned untouched (never reach recoverFragment).
  private static cleanArtifacts(cands: string[]): string[] {
    const out: string[] = [];
    const seen = new Set<string>();
    const add = (x: string): void => { if (!seen.has(x)) { seen.add(x); out.push(x); } };
    for (const c of cands) {
      if (!KanaKanjiConverter.isMarkupArtifact(c)) { add(c); continue; }
      const r = KanaKanjiConverter.recoverFragment(c);
      if (r !== c && r.length >= 2 && !KanaKanjiConverter.isMarkupArtifact(r)) { add(r); }
      // else: unrecoverable markup — drop it
    }
    return out;
  }

  private static hasKanjiChar(c: string): boolean {
    return /[一-鿿々〆〇]/.test(c);
  }

  // A candidate with no kana, kanji, or alphanumerics — i.e. only brackets /
  // arrows / punctuation, like "()" or "→". Used to keep such symbol "words"
  // (e.g. かっこ→"()") out of joined multi-segment phrases.
  static isSymbolOnly(c: string): boolean {
    return c.length > 0 && !/[ぁ-んァ-ヶ一-鿿々〆〇ーA-Za-z0-9０-９]/.test(c);
  }

  private static isPureKatakana(c: string): boolean {
    return /^[ァ-ヶーヽヾ・゠]+$/.test(c);
  }

  // AABB-style reduplication (どきどき, ふらふら, ぱぱ) — the standard shape of
  // Japanese-native mimetic/onomatopoeic words and doubled colloquialisms.
  // Used to tell those apart from foreign loanwords when both a katakana form
  // and the bare hiragana reading are authored for the same key (see
  // writableBothWays below): a loanword just happens to also list its
  // as-typed hiragana as a fallback candidate, while a mimetic word's
  // hiragana form is the genuinely preferred writing.
  private static isReduplicated(kana: string): boolean {
    const n = kana.length;
    return n > 0 && n % 2 === 0 && kana.slice(0, n / 2) === kana.slice(n / 2);
  }

  // Specific mixed-case/lowercase Latin brand & tech terms that are the
  // *correct* real-world spelling (official stylization or a lowercase
  // command/term), not leaked romaji-conversion junk — exempted from the
  // ALL-CAPS-only romaji filter below on a per-string basis rather than by
  // loosening the general rule (which exists to keep scraped garbage out of
  // the other ~190k dictionary entries).
  private static readonly LATIN_WHITELIST = new Set<string>([
    'HarmonyOS', 'boot', 'vivo', 'OnePlus', 'Redmi', 'realme', 'Meizu',
    'nubia', 'iQOO', 'Lenovo',
  ]);

  // Remove half-width katakana and pure-ASCII romaji only.
  // Full-width katakana is always kept (loanwords need カタカナ even when kanji exists).
  private static filterCandidates(kana: string, cands: string[]): string[] {
    const preFiltered = cands.filter(c => {
      if (/^[ｦ-ﾟ]+$/.test(c)) { return false; } // half-width katakana
      // romaji / latin, but keep short ALL-CAPS acronyms (PTA, NHK, SNS, OK,
      // DL, PC) — real Japanese-context words, not romaji-conversion junk.
      if (/^[A-Za-zÀ-ɏ]+$/.test(c) && !/^[A-Z]{2,6}$/.test(c)
          && !KanaKanjiConverter.LATIN_WHITELIST.has(c)) { return false; }
      return true;
    });
    // Recover clean words from bracket-fragment candidates, then drop the rest.
    const filtered = KanaKanjiConverter.cleanArtifacts(preFiltered);
    return filtered.length > 0 ? filtered : [kana];
  }

  private inDict(sub: string): boolean {
    if (KanaKanjiConverter.isMozcEngine()) {
      // Track B (and hybrid, which reuses track B's DP/segmentation
      // unchanged -- see field comments near `engine`) is deliberately its
      // own closed world: FUNCTION_WORDS/FW_CLASS_MAP are track-A hand-tuned
      // grammar tables, not part of mozc's own data, so they don't apply
      // here, and hybrid's applyHybridOverride only ever REORDERS candidates
      // mozc's own stats already proposed (see its comment for why), so it
      // needs no extra DP-eligible spans either. The USER dictionary is the
      // one exception: explicit user registrations are engine-independent
      // intent, and without this a registered novel word could never even
      // become a DP span (getWordInfoCandidatesMozc gives such spans a
      // generic-noun sense).
      return KanaKanjiConverter.mozcReadingIndex.has(sub) || !!KanaKanjiConverter.userDict[sub];
    }
    return !!(KanaKanjiConverter.globalDict[sub]
      || KanaKanjiConverter.userDict[sub]
      || KanaKanjiConverter.supplementaryDict[sub]
      || DICTIONARY[sub]
      || KanaKanjiConverter.FW_CLASS_MAP[sub] !== undefined
      || KanaKanjiConverter.FUNCTION_WORDS[sub]);
  }

  // True if `reading` is a *content* word authored in one of the dictionaries
  // (DICTIONARY/global/user/supplementary) — not merely a function word. Used
  // by the keyboard's sentence-conversion path to recognise that a whole
  // reading is a known word (e.g. a loanword こんびに→コンビニ) so it isn't
  // re-segmented into pieces just because its authored surface happens to be
  // katakana (which the segment path can't distinguish from an auto-fallback).
  static isDictionaryWord(reading: string): boolean {
    if (KanaKanjiConverter.isMozcEngine()) {
      return KanaKanjiConverter.mozcReadingIndex.has(reading);
    }
    return !!(DICTIONARY[reading]
      || KanaKanjiConverter.globalDict[reading]
      || KanaKanjiConverter.userDict[reading]
      || KanaKanjiConverter.supplementaryDict[reading]);
  }

  // Returns true for kana that cannot start a Japanese word/morpheme.
  private static isNoStarter(c: string): boolean {
    return 'っゃゅょぁぃぅぇぉゎんー'.indexOf(c) >= 0;
  }

  // Phase-2.5 Viterbi POS class IDs (100 classes).
  // Full list: tools/gen_matrix_default.py.  Must match tools/build_viterbi_dict.py.
  // Nouns 0-13 | Verbs 14-33 | Adj 34-41 | Adv 42-47
  // Case-P 48-57 | Topic-P 58-62 | Conj-P 63-68 | Final-P 69-72
  // Aux 73-86 | Conj 87-89 | Other 90-97 | Unknown=98 | BOS=99
  private static readonly VC_UNKNOWN  = 98;
  private static readonly VC_NOUN     = 0;   // N_GENERAL
  private static readonly VC_BOS      = 99;
  // Fine-grained class IDs for common function words used as getWordInfo() fallback.
  // Fine-grained class IDs for function words; checked first in getWordInfo().
  private static readonly FW_CLASS_MAP: Record<string, number> = {
    // Case particles (48-57)
    'が': 48, 'を': 49, 'に': 50, 'で': 51, 'と': 52, 'の': 53,
    'へ': 54, 'より': 55, 'から': 56, 'まで': 57,
    // Topic / focus / extent (58-62)
    'は': 58, 'も': 59,
    'こそ': 60, 'だけ': 60, 'しか': 60, 'さえ': 60,
    'ほど': 61, 'くらい': 61, 'ぐらい': 61, 'など': 61, 'ばかり': 61,
