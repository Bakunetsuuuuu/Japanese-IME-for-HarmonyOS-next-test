  static loadDictionary(dict: Record<string, string[]>): void {
    KanaKanjiConverter.supplementaryDict = dict;
  }

  static setUserDict(dict: Record<string, string[]>): void {
    KanaKanjiConverter.userDict = dict;
  }

  static setGlobalDict(dict: Record<string, string[]>): void {
    KanaKanjiConverter.globalDict = dict;
  }

  static setCostDict(dict: Record<string, number[]>): void {
    KanaKanjiConverter.costDict = dict;
  }

  static setConnectionMatrix(m: number[][]): void {
    KanaKanjiConverter.connectionMatrix = m;
  }

  static setLearned(data: Record<string, Record<string, number>>): void {
    KanaKanjiConverter.learned = data;
  }

  static getLearned(): Record<string, Record<string, number>> {
    return KanaKanjiConverter.learned;
  }

  static recordChoice(kana: string, candidate: string): void {
    if (kana.length === 0 || candidate.length === 0 || candidate === kana) { return; }
    if (!KanaKanjiConverter.learned[kana]) {
      if (Object.keys(KanaKanjiConverter.learned).length >= 500) { return; }
      KanaKanjiConverter.learned[kana] = {};
    }
    const entry = KanaKanjiConverter.learned[kana];
    if (entry[candidate] !== undefined || Object.keys(entry).length < 5) {
      entry[candidate] = (entry[candidate] ?? 0) + 1;
    }
  }

  private static applyLearning(kana: string, cands: string[]): string[] {
    const counts = KanaKanjiConverter.learned[kana];
    if (!counts || Object.keys(counts).length === 0) { return cands; }
    const boosted = cands.filter((c: string) => (counts[c] ?? 0) > 0)
      .sort((a: string, b: string) => (counts[b] ?? 0) - (counts[a] ?? 0));
    const rest = cands.filter((c: string) => (counts[c] ?? 0) === 0);
    return [...boosted, ...rest];
  }

  // Prepend user-registered words (deduped), keeping them ahead of dict order.
  // Prepend the words of a registered dictionary (deduped), keeping them ahead.
  private static withRegisteredWords(
    registered: string[] | undefined,
    list: string[]
  ): string[] {
    if (!registered || registered.length === 0) { return list; }
    const rest = list.filter((c: string) => !registered.includes(c));
    return [...registered, ...rest];
  }

  static addContext(text: string): void {
    if (text.length === 0) { return; }
    KanaKanjiConverter.contextBuffer.push(text);
    if (KanaKanjiConverter.contextBuffer.length > 15) {
      KanaKanjiConverter.contextBuffer = KanaKanjiConverter.contextBuffer.slice(1);
    }
  }

  private static contextRerank(reading: string, cands: string[]): string[] {
    const buffer = KanaKanjiConverter.contextBuffer;
    if (buffer.length === 0) { return cands; }
    const scores: number[] = [];
    let hasSignal = false;
    for (let i = 0; i < cands.length; i++) {
      const key = reading + '|' + cands[i];
      const triggers = CONTEXT_HINTS[key];
      let score = 0;
      if (triggers) {
        for (const ctx of buffer) {
          for (const trigger of triggers) {
            if (ctx.indexOf(trigger) >= 0) { score += 1; }
          }
        }
      }
      scores.push(score);
      if (score > 0) { hasSignal = true; }
    }
    if (!hasSignal) { return cands; }
    // Stable insertion sort descending by score
    const order: number[] = [];
    for (let i = 0; i < cands.length; i++) { order.push(i); }
    for (let i = 1; i < order.length; i++) {
      const pivot = order[i];
      let j = i - 1;
      while (j >= 0 && scores[order[j]] < scores[pivot]) {
        order[j + 1] = order[j];
        j -= 1;
      }
      order[j + 1] = pivot;
    }
    const result: string[] = [];
    for (const idx of order) { result.push(cands[idx]); }
    return result;
  }

  lookup(kana: string): string[] {
    const entry = DICTIONARY[kana];
    const ext = KanaKanjiConverter.supplementaryDict[kana];
    const user = KanaKanjiConverter.userDict[kana];
    const global = KanaKanjiConverter.globalDict[kana];
    const kata = KanaKanjiConverter.toKatakana(kana);
    let cands: string[];

    if (entry && entry.length > 0) {
      cands = [...entry];
      if (ext && ext.length > 0) {
        for (const c of ext) {
          if (!cands.includes(c)) { cands.push(c); }
        }
      }
      if (kata !== kana && !cands.includes(kata)) { cands.push(kata); }
      if (!cands.includes(kana)) { cands.push(kana); }
    } else if (ext && ext.length > 0) {
      cands = [...ext];
      if (kata !== kana && !cands.includes(kata)) { cands.push(kata); }
      if (!cands.includes(kana)) { cands.push(kana); }
    } else if ((user && user.length > 0) || (global && global.length > 0)) {
      // Only a registered dictionary (user/global) knows this reading.
      cands = [];
      if (kata !== kana) { cands.push(kata); }
      if (!cands.includes(kana)) { cands.push(kana); }
      // user leads global; both prepended ahead of the katakana/kana fallback.
      const withGlobal = KanaKanjiConverter.withRegisteredWords(global, cands);
      return KanaKanjiConverter.withRegisteredWords(user, withGlobal);
    } else {
      // Not in any dict: katakana first (handles loanwords not yet in dict)
      return kata !== kana ? [kata, kana] : [kana];
    }

    const filtered = KanaKanjiConverter.filterCandidates(kana, cands);
    // Function words (particles/auxiliaries) default to hiragana, not rare kanji
    // (e.g. ない should lead with かな, not 綯い).
    let ordered: string[];
    if (KanaKanjiConverter.FUNCTION_WORDS[kana] && filtered[0] !== kana) {
      const reordered = filtered.filter((c: string) => c !== kana);
      reordered.unshift(kana);
      ordered = KanaKanjiConverter.applyLearning(kana, reordered);
    } else {
      ordered = KanaKanjiConverter.applyLearning(kana, filtered);
    }
    // Registered words always lead: global first, then user prepended → user wins.
    const withGlobal = KanaKanjiConverter.withRegisteredWords(global, ordered);
    const final = KanaKanjiConverter.withRegisteredWords(user, withGlobal);
    return KanaKanjiConverter.contextRerank(kana, final);
  }

  // Returns the best single conversion: keeps kana for function words, else first lookup candidate.
  autoConvert(kana: string): string {
    if (KanaKanjiConverter.FUNCTION_WORDS[kana]) {
      return kana;
    }
    return this.lookup(kana)[0];
  }

  // Convert hiragana to katakana (U+3041-U+3096 → U+30A1-U+30F6, offset 0x60).
  static toKatakana(hiragana: string): string {
    let result = '';
    for (let i = 0; i < hiragana.length; i++) {
      const code = hiragana.charCodeAt(i);
      result += (code >= 0x3041 && code <= 0x3096)
        ? String.fromCharCode(code + 0x60)
        : hiragana[i];
    }
    return result;
  }

  // Remove half-width katakana and pure-ASCII romaji only.
  // Full-width katakana is always kept (loanwords need カタカナ even when kanji exists).
  private static filterCandidates(kana: string, cands: string[]): string[] {
    const filtered = cands.filter(c => {
      if (/^[ｦ-ﾟ]+$/.test(c)) { return false; } // half-width katakana
      if (/^[A-Za-zÀ-ɏ]+$/.test(c)) { return false; } // romaji / latin
      return true;
    });
    return filtered.length > 0 ? filtered : [kana];
  }

  private inDict(sub: string): boolean {
    return !!(KanaKanjiConverter.globalDict[sub]
      || KanaKanjiConverter.userDict[sub]
      || KanaKanjiConverter.supplementaryDict[sub]
      || DICTIONARY[sub]);
  }

  // Returns true for kana that cannot start a Japanese word/morpheme.
  private static isNoStarter(c: string): boolean {
    return 'っゃゅょぁぃぅぇぉゎんー'.indexOf(c) >= 0;
  }

  // Viterbi macro-class IDs (must match tools/build_viterbi_dict.py)
  private static readonly VC_UNKNOWN  = 0;
  private static readonly VC_NOUN     = 1;
  private static readonly VC_PARTICLE = 6;
  private static readonly VC_BOS      = 14;
  // Fallback node costs when reading_cost.json is not loaded or reading is not found.
  // Calibrated to the IPAdic cost scale (median content word ≈ 5600, particles ≈ 4000,
  // p90 ≈ 8500, max ≈ 15000) so words with real cost data and fallback words compete fairly.
  private static readonly VN_UNKNOWN_SINGLE = 13000; // single unknown char — heavy penalty
  private static readonly VN_FUNCTION_WORD  = 4000;  // known function word (particle scale)
  private static readonly VN_DEFAULT        = 6000;  // known dict entry without cost data (≈ median)

  // Returns [nodeCost, leftMacroClass, rightMacroClass] for a kana segment.
  private getWordInfo(sub: string): number[] {
    const e = KanaKanjiConverter.costDict[sub];
    if (e && e.length >= 3) { return e; }
    if (sub.length === 1 && !this.inDict(sub)) {
      return [KanaKanjiConverter.VN_UNKNOWN_SINGLE,
              KanaKanjiConverter.VC_UNKNOWN, KanaKanjiConverter.VC_UNKNOWN];
    }
    if (KanaKanjiConverter.FUNCTION_WORDS[sub]) {
      return [KanaKanjiConverter.VN_FUNCTION_WORD,
              KanaKanjiConverter.VC_PARTICLE, KanaKanjiConverter.VC_PARTICLE];
    }
    return [KanaKanjiConverter.VN_DEFAULT,
            KanaKanjiConverter.VC_NOUN, KanaKanjiConverter.VC_NOUN];
  }

  // Connection cost between adjacent segments using the 15×15 matrix.
  // Returns 0 when the matrix is not yet loaded (neutral — falls back to node-cost-only ranking).
  private getEdgeCost(prevRightClass: number, curLeftClass: number): number {
    const m = KanaKanjiConverter.connectionMatrix;
    if (m.length === 0) { return 0; }
    const row = m[prevRightClass];
    if (!row) { return 0; }
    return row[curLeftClass] ?? 0;
  }

  // Minimum-cost Viterbi lattice segmentation.
  // Node costs come from reading_cost.json (real IPAdic costs); edge costs from matrix.json.
  // Falls back gracefully to heuristic costs when data files are not loaded.
  segment(kana: string): string[] {
    const n = kana.length;
    if (n === 0) { return []; }
    const INF = 1000000000;
    const MAX_LEN = 10;

    // best[i]       = minimum total cost to reach position i
    // prevPos[i]    = starting position of the segment ending at i (for backtrace)
    // rightClass[i] = right macro-class of the word ending at i (for edge cost of next word)
    const best: number[] = [];
    const prevPos: number[] = [];
    const rightClass: number[] = [];
    for (let j = 0; j <= n; j++) {
      best.push(INF);
      prevPos.push(-1);
      rightClass.push(KanaKanjiConverter.VC_BOS);
    }
    best[0] = 0;

    for (let i = 0; i < n; i++) {
      if (best[i] === INF) { continue; }
      const maxLen = MAX_LEN < n - i ? MAX_LEN : n - i;
      for (let len = 1; len <= maxLen; len++) {
        const sub = kana.slice(i, i + len);
        if (len > 1 && !this.inDict(sub)) { continue; }
        const info = this.getWordInfo(sub);
        const nc = info[0];
        const lc = info[1];
        const rc = info[2];
        const total = best[i] + nc + this.getEdgeCost(rightClass[i], lc);
        if (total < best[i + len]) {
          best[i + len] = total;
          prevPos[i + len] = i;
          rightClass[i + len] = rc;
        }
      }
    }

    // Backtrace from n to 0
    const segs: string[] = [];
    let pos = n;
    while (pos > 0) {
      const p = prevPos[pos];
      if (p < 0) { break; }
      segs.unshift(kana.slice(p, pos));
      pos = p;
    }

    // Merge segments starting with a non-word-start kana into the previous segment.
    // e.g. ["い","っしょ"] → ["いっしょ"]
    const merged: string[] = [];
    for (const seg of segs) {
      if (merged.length > 0 && KanaKanjiConverter.isNoStarter(seg[0])) {
        merged[merged.length - 1] += seg;
      } else {
        merged.push(seg);
      }
    }
    return merged;
  }
}
